    "build": {
      "requires": [
        "git",
        "python"
      ],
      "install": [
        "tools/install.py",
        "--iso",
        "{romPath}",
        "--work-dir",
        "{workDir}"
      ],
      "run": [
        "tools/project.py",
        "run"
      ],
      "requirements": "Python 3, Git, and Visual Studio 2022 or newer with “Desktop development with C++”, plus about 20 GB free. The first build takes 30 to 90 minutes."
