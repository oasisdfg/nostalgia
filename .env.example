# IGDB (Twitch) credentials — dev fallback only.
# Preferred: enter these in the app under Settings → IGDB (the secret is then
# encrypted at rest via the OS keystore). This .env is a convenience for dev and
# is git-ignored. The values are read in the main process only and never exposed
# to the renderer.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
